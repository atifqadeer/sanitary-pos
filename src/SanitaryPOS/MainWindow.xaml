<Window x:Class="SanitaryPOS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource AppTitle}"
        Width="1366" Height="768"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F4">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== Header (spans both columns) ===== -->
        <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Background="#1E7D32">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding ShopNameText}"
                           Foreground="White" FontSize="18" FontWeight="Bold"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CurrentUserText}" Foreground="White"
                               VerticalAlignment="Center" Margin="8,0" FontSize="13"/>
                    <!-- Language toggle: EN / اردو — instant swap, no restart -->
                    <Button Content="EN" Command="{Binding SetLanguageCommand}" CommandParameter="en"
                            Padding="12,5" Margin="3,0" FontWeight="Bold"/>
                    <Button Content="اردو" Command="{Binding SetLanguageCommand}" CommandParameter="ur"
                            Padding="12,5" Margin="3,0" FontWeight="Bold"/>
                    <Button Content="{DynamicResource Logout}" Command="{Binding LogoutCommand}"
                            Padding="12,5" Margin="8,0,0,0"
                            Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Sidebar (hidden until login) ===== -->
        <Border Grid.Row="1" Grid.Column="0" Background="White" BorderBrush="#DDD" BorderThickness="0,0,1,0"
                Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVis}}">
            <StackPanel Width="205">
                <Button Style="{StaticResource NavButton}" Content="{DynamicResource NavDashboard}"
                        Command="{Binding NavigateCommand}" CommandParameter="Dashboard"/>
                <Button Style="{StaticResource NavButton}" Content="{DynamicResource NavBilling}"
                        Command="{Binding NavigateCommand}" CommandParameter="Billing"/>
                <Button Style="{StaticResource NavButton}" Content="{DynamicResource NavQuotation}"
                        Command="{Binding NavigateCommand}" CommandParameter="Quotation"/>
                <Button Style="{StaticResource NavButton}" Content="{DynamicResource NavProducts}"
                        Command="{Binding NavigateCommand}" CommandParameter="Products"/>
                <Button Style="{StaticResource NavButton}" Content="{DynamicResource NavCustomers}"
                        Command="{Binding NavigateCommand}" CommandParameter="Customers"/>
                <Separator Margin="8,6"/>
                <Button Style="{StaticResource NavButton}" Content="{DynamicResource NavPurchase}"
                        Command="{Binding NavigateCommand}" CommandParameter="Purchase"/>
                <Button Style="{StaticResource NavButton}" Content="{DynamicResource NavSuppliers}"
                        Command="{Binding NavigateCommand}" CommandParameter="Suppliers"/>
                <Button Style="{StaticResource NavButton}" Content="{DynamicResource NavReturns}"
                        Command="{Binding NavigateCommand}" CommandParameter="Returns"/>
                <Button Style="{StaticResource NavButton}" Content="{DynamicResource NavReports}"
                        Command="{Binding NavigateCommand}" CommandParameter="Reports"/>
                <Button Style="{StaticResource NavButton}" Content="{DynamicResource NavUsers}"
                        Command="{Binding NavigateCommand}" CommandParameter="Users" Opacity="0.55"/>
                <Separator Margin="8,6"/>
                <Button Style="{StaticResource NavButton}" Content="{DynamicResource NavSettings}"
                        Command="{Binding NavigateCommand}" CommandParameter="Settings"/>
            </StackPanel>
        </Border>

        <!-- ===== Current screen ===== -->
        <ContentControl Grid.Row="1" Grid.Column="1" Content="{Binding CurrentView}" Margin="10"/>
    </Grid>
</Window>
