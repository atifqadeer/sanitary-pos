<Application x:Class="SanitaryPOS.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SanitaryPOS.ViewModels"
             xmlns:views="clr-namespace:SanitaryPOS.Views"
             xmlns:helpers="clr-namespace:SanitaryPOS.Helpers">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Default language dictionary (Urdu). LocalizationService swaps this at runtime. -->
                <ResourceDictionary Source="Localization/Strings.ur.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- ===== Value converters ===== -->
            <helpers:MoneyValueConverter x:Key="MoneyConverter"/>
            <helpers:DateDisplayConverter x:Key="DateConverter"/>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>

            <!-- ===== ViewModel -> View mapping (navigation) ===== -->
            <DataTemplate DataType="{x:Type vm:LoginViewModel}">
                <views:LoginView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                <views:DashboardView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ProductsViewModel}">
                <views:ProductsView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:BillingViewModel}">
                <views:BillingView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:QuotationsViewModel}">
                <views:QuotationsView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:CustomersViewModel}">
                <views:CustomersView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:PurchaseViewModel}">
                <views:PurchaseView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SuppliersViewModel}">
                <views:SuppliersView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ReturnsViewModel}">
                <views:ReturnsView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ReportsViewModel}">
                <views:ReportsView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:UsersViewModel}">
                <views:UsersView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DayEndViewModel}">
                <views:DayEndView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:PlaceholderViewModel}">
                <views:PlaceholderView/>
            </DataTemplate>

            <!-- ===== Shared styles: big, simple, touch friendly ===== -->
            <Style x:Key="BigButton" TargetType="Button">
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="Padding" Value="14,8"/>
                <Setter Property="Margin" Value="4"/>
                <Setter Property="MinHeight" Value="38"/>
                <Setter Property="Cursor" Value="Hand"/>
            </Style>

            <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BigButton}">
                <Setter Property="Background" Value="#1E7D32"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontWeight" Value="Bold"/>
            </Style>

            <Style x:Key="NavButton" TargetType="Button">
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="Padding" Value="12,10"/>
                <Setter Property="Margin" Value="6,3"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
            </Style>

            <Style x:Key="HeaderText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="20"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
            </Style>

            <Style x:Key="FormLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Foreground" Value="#444"/>
                <Setter Property="Margin" Value="0,6,0,2"/>
            </Style>

            <Style x:Key="FormTextBox" TargetType="TextBox">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Padding" Value="6,4"/>
                <Setter Property="Margin" Value="0,0,0,4"/>
            </Style>

            <Style x:Key="FormCombo" TargetType="ComboBox">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Padding" Value="6,4"/>
                <Setter Property="Margin" Value="0,0,0,4"/>
            </Style>

            <Style x:Key="StatCard" TargetType="Border">
                <Setter Property="Background" Value="White"/>
                <Setter Property="BorderBrush" Value="#DDD"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="16"/>
                <Setter Property="Margin" Value="6"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
