<UserControl x:Class="SanitaryPOS.Views.DayEndView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="{DynamicResource DayEndTitle}" Style="{StaticResource HeaderText}"/>

            <StackPanel Orientation="Horizontal" Margin="0,2,0,10">
                <TextBlock Text="{DynamicResource Date}" VerticalAlignment="Center" FontWeight="Bold"/>
                <DatePicker SelectedDate="{Binding SelectedDate}" Width="160" Margin="8,0,0,0"
                            VerticalAlignment="Center"/>
                <Button Content="{DynamicResource Refresh}" Style="{StaticResource BigButton}"
                        Command="{Binding RefreshDayCommand}" Margin="10,0,0,0"/>
                <Button Content="{DynamicResource PrintZReport}" Style="{StaticResource BigButton}"
                        Command="{Binding PrintZReportCommand}" Margin="8,0,0,0"/>
            </StackPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ===== Day summary rows ===== -->
                <DataGrid Grid.Column="0" ItemsSource="{Binding SummaryRows}" AutoGenerateColumns="False"
                          IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"
                          MaxHeight="430" Margin="0,0,8,0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{DynamicResource Description}" Binding="{Binding C1}" Width="*"/>
                        <DataGridTextColumn Header="{DynamicResource Amount}" Binding="{Binding C2}" Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- ===== Sales by payment method ===== -->
                <DataGrid Grid.Column="1" ItemsSource="{Binding MethodRows}" AutoGenerateColumns="False"
                          IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"
                          MaxHeight="430" Margin="8,0,0,0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{DynamicResource PaymentMethod}" Binding="{Binding C1}" Width="*"/>
                        <DataGridTextColumn Header="{DynamicResource Bills}" Binding="{Binding C2}" Width="70"/>
                        <DataGridTextColumn Header="{DynamicResource Total}" Binding="{Binding C3}" Width="120"/>
                        <DataGridTextColumn Header="{DynamicResource Paid}" Binding="{Binding C4}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <TextBlock Text="{DynamicResource ExpectedCashNote}" TextWrapping="Wrap"
                       Foreground="#888" FontSize="12" Margin="0,8,0,0"/>

            <!-- ===== Already-closed record ===== -->
            <Border BorderBrush="#2E7D32" BorderThickness="1" Background="#E8F5E9" Padding="10" Margin="0,10,0,0"
                    Visibility="{Binding IsClosed, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding ClosingStatusText}" FontWeight="Bold" TextWrapping="Wrap"/>
            </Border>

            <!-- ===== Count + close (Admin only, day still open) ===== -->
            <Border BorderBrush="#CCC" BorderThickness="1" Padding="10" Margin="0,10,0,0"
                    Visibility="{Binding CanClose, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource ExpectedCash}" Style="{StaticResource FormLabel}"/>
                        <TextBlock Text="{Binding ExpectedText}" FontSize="20" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Margin="28,0,0,0">
                        <TextBlock Text="{DynamicResource CountedCash}" Style="{StaticResource FormLabel}"/>
                        <TextBox Text="{Binding CountedText, UpdateSourceTrigger=PropertyChanged}"
                                 Width="150" FontSize="16" Padding="6,4"/>
                    </StackPanel>
                    <StackPanel Margin="28,0,0,0">
                        <TextBlock Text="{DynamicResource Difference}" Style="{StaticResource FormLabel}"/>
                        <TextBlock Text="{Binding DifferenceText}" FontSize="20" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Margin="28,0,0,0" Width="280">
                        <TextBlock Text="{DynamicResource Note}" Style="{StaticResource FormLabel}"/>
                        <TextBox Text="{Binding NoteText}" FontSize="14" Padding="6,4"/>
                    </StackPanel>
                    <Button Content="{DynamicResource CloseDay}" Style="{StaticResource PrimaryButton}"
                            Command="{Binding CloseDayCommand}" VerticalAlignment="Bottom" Margin="20,0,0,0"/>
                </StackPanel>
            </Border>

            <!-- ===== Closings history ===== -->
            <TextBlock Text="{DynamicResource ClosingsHistory}" Style="{StaticResource FormLabel}"
                       FontWeight="Bold" FontSize="15" Margin="0,18,0,4"/>
            <DataGrid ItemsSource="{Binding History}" AutoGenerateColumns="False"
                      IsReadOnly="True" CanUserAddRows="False" MaxHeight="260">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{DynamicResource Date}" Binding="{Binding DateText}" Width="110"/>
                    <DataGridTextColumn Header="{DynamicResource ExpectedCash}" Binding="{Binding ExpectedPaisa, Converter={StaticResource MoneyConverter}}" Width="130"/>
                    <DataGridTextColumn Header="{DynamicResource CountedCash}" Binding="{Binding CountedPaisa, Converter={StaticResource MoneyConverter}}" Width="130"/>
                    <DataGridTextColumn Header="{DynamicResource Difference}" Binding="{Binding DifferencePaisa, Converter={StaticResource MoneyConverter}}" Width="130"/>
                    <DataGridTextColumn Header="{DynamicResource ClosedBy}" Binding="{Binding ClosedByName}" Width="130"/>
                    <DataGridTextColumn Header="{DynamicResource Note}" Binding="{Binding Note}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
