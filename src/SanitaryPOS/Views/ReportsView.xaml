<UserControl x:Class="SanitaryPOS.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock Text="{DynamicResource ReportsTitle}" Style="{StaticResource HeaderText}"/>
            <TextBlock Text="{Binding ReportTitle}" FontSize="15" FontWeight="Bold" Foreground="#1E7D32"
                       VerticalAlignment="Center" Margin="14,0,0,8"/>
        </StackPanel>

        <!-- Picker + date range + presets + run -->
        <WrapPanel Grid.Row="1" Margin="0,0,0,8">
            <StackPanel Margin="0,0,10,0">
                <TextBlock Text="{DynamicResource ReportType}" Style="{StaticResource FormLabel}"/>
                <ComboBox ItemsSource="{Binding ReportTypes}" SelectedItem="{Binding SelectedReport}"
                          Width="210" FontSize="14" Padding="6,4"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,0">
                <TextBlock Text="{DynamicResource FromDate}" Style="{StaticResource FormLabel}"/>
                <DatePicker SelectedDate="{Binding FromDate}" FontSize="14"/>
            </StackPanel>
            <StackPanel Margin="0,0,10,0">
                <TextBlock Text="{DynamicResource ToDate}" Style="{StaticResource FormLabel}"/>
                <DatePicker SelectedDate="{Binding ToDate}" FontSize="14"/>
            </StackPanel>
            <StackPanel Margin="0,0,4,0">
                <TextBlock Text=" " Style="{StaticResource FormLabel}"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="{DynamicResource TodayBtn}" Style="{StaticResource BigButton}"
                            Command="{Binding PresetTodayCommand}"/>
                    <Button Content="{DynamicResource ThisWeekBtn}" Style="{StaticResource BigButton}"
                            Command="{Binding PresetWeekCommand}"/>
                    <Button Content="{DynamicResource ThisMonthBtn}" Style="{StaticResource BigButton}"
                            Command="{Binding PresetMonthCommand}"/>
                </StackPanel>
            </StackPanel>
            <StackPanel>
                <TextBlock Text=" " Style="{StaticResource FormLabel}"/>
                <Button Content="{DynamicResource RunReport}" Style="{StaticResource PrimaryButton}"
                        Command="{Binding RunReportCommand}" MinWidth="150"/>
            </StackPanel>
        </WrapPanel>

        <!-- One generic grid for every report; headings are set by the ViewModel per report -->
        <DataGrid Grid.Row="2" ItemsSource="{Binding Rows}" AutoGenerateColumns="False"
                  IsReadOnly="True" CanUserAddRows="False" FontSize="13.5">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{Binding DataContext.Header1, RelativeSource={RelativeSource AncestorType=UserControl}}" Binding="{Binding C1}" Width="*"/>
                <DataGridTextColumn Header="{Binding DataContext.Header2, RelativeSource={RelativeSource AncestorType=UserControl}}" Binding="{Binding C2}" Width="170"/>
                <DataGridTextColumn Header="{Binding DataContext.Header3, RelativeSource={RelativeSource AncestorType=UserControl}}" Binding="{Binding C3}" Width="170"/>
                <DataGridTextColumn Header="{Binding DataContext.Header4, RelativeSource={RelativeSource AncestorType=UserControl}}" Binding="{Binding C4}" Width="170"/>
                <DataGridTextColumn Header="{Binding DataContext.Header5, RelativeSource={RelativeSource AncestorType=UserControl}}" Binding="{Binding C5}" Width="170"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="3" Margin="0,8,0,0">
            <TextBlock Text="{Binding TotalText}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{DynamicResource Print}" Style="{StaticResource BigButton}"
                        Command="{Binding PrintReportCommand}"/>
                <Button Content="{DynamicResource ExportExcelCsv}" Style="{StaticResource BigButton}"
                        Command="{Binding ExportCsvCommand}"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
