<UserControl x:Class="SanitaryPOS.Views.QuotationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="210"/>
        </Grid.RowDefinitions>

        <!-- ===== Top: new quotation editor ===== -->
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="64"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{DynamicResource Quotations}" Style="{StaticResource HeaderText}"/>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="190"/>
                    <ColumnDefinition Width="160"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" Grid.Column="0" FontSize="15" Padding="7,5" Margin="0,0,8,6"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="{DynamicResource ScanOrSearch}" KeyDown="SearchBox_KeyDown"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding CustomerOptions}" SelectedItem="{Binding SelectedCustomer}"
                          FontSize="13" Padding="5,3" Margin="0,0,8,6"/>
                <ComboBox Grid.Column="2" ItemsSource="{Binding PriceLevels}" SelectedItem="{Binding SelectedPriceLevel}"
                          FontSize="13" Padding="5,3" Margin="0,0,8,6"/>
                <TextBox Grid.Column="3" Text="{Binding GuestName}" FontSize="13" Padding="5,3" Margin="0,0,8,6"
                         ToolTip="{DynamicResource GuestName}"/>
                <TextBox Grid.Column="4" Text="{Binding GuestMobile}" FontSize="13" Padding="5,3" Margin="0,0,0,6"
                         ToolTip="{DynamicResource GuestMobile}"/>
            </Grid>

            <ListBox x:Name="ResultsList" Grid.Row="2" FontSize="12.5" ItemsSource="{Binding SearchResults}"
                     MouseDoubleClick="ResultsList_MouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock>
                            <Run Text="{Binding Name, Mode=OneWay}" FontWeight="Bold"/>
                            <Run Text="  |  "/><Run Text="{Binding BrandName, Mode=OneWay}"/>
                            <Run Text="  |  "/><Run Text="{Binding RetailRatePaisa, Converter={StaticResource MoneyConverter}, Mode=OneWay}"/>
                        </TextBlock>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <DataGrid Grid.Row="3" ItemsSource="{Binding Lines}" AutoGenerateColumns="False"
                      CanUserAddRows="False" FontSize="13.5" Margin="0,6,0,0" RowHeight="28">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{DynamicResource Item}" Binding="{Binding ProductName}" Width="*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="{DynamicResource Qty}" Binding="{Binding Qty, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                    <DataGridTextColumn Header="{DynamicResource Rate}" Binding="{Binding RateRupees, UpdateSourceTrigger=PropertyChanged, StringFormat=0.##}" Width="90"/>
                    <DataGridTemplateColumn Header="%" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding DataContext.DiscountModes, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          SelectedItem="{Binding DiscountMode, UpdateSourceTrigger=PropertyChanged}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{DynamicResource DiscountValue}" Binding="{Binding DiscountValue, UpdateSourceTrigger=PropertyChanged, StringFormat=0.##}" Width="80"/>
                    <DataGridTextColumn Header="{DynamicResource LineTotal}" Binding="{Binding LineTotalPaisa, Converter={StaticResource MoneyConverter}}" Width="105" IsReadOnly="True"/>
                    <DataGridTemplateColumn Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="{DynamicResource Remove}"
                                        Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock VerticalAlignment="Center">
                    <Run Text="{DynamicResource Subtotal}"/><Run Text=": "/>
                    <Run Text="{Binding SubtotalText, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock Text="{DynamicResource BillDiscount}" VerticalAlignment="Center" Margin="14,0,4,0"/>
                <TextBox Text="{Binding BillDiscountText, UpdateSourceTrigger=PropertyChanged}" Width="100" FontSize="14" Padding="5,3"/>
                <TextBlock FontSize="17" FontWeight="Bold" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Run Text="{DynamicResource GrandTotal}"/><Run Text=": "/>
                    <Run Text="{Binding GrandTotalText, Mode=OneWay}"/>
                </TextBlock>
                <Button Content="{DynamicResource NewQuotation}" Style="{StaticResource BigButton}"
                        Command="{Binding NewQuotationCommand}" Margin="18,0,0,0"/>
                <Button Content="{DynamicResource SaveQuotation}" Style="{StaticResource PrimaryButton}"
                        Command="{Binding SaveQuotationCommand}"/>
            </StackPanel>
        </Grid>

        <!-- ===== Bottom: saved quotations ===== -->
        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <DataGrid Grid.Row="0" ItemsSource="{Binding SavedQuotations}" SelectedItem="{Binding SelectedQuotation}"
                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" FontSize="13">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{DynamicResource QuotationNo}" Binding="{Binding QuotationNo}" Width="90"/>
                    <DataGridTextColumn Header="{DynamicResource Date}" Binding="{Binding CreatedAt, Converter={StaticResource DateConverter}}" Width="100"/>
                    <DataGridTextColumn Header="{DynamicResource Customer}" Binding="{Binding CustomerNameSnapshot}" Width="*"/>
                    <DataGridTextColumn Header="{DynamicResource Total}" Binding="{Binding TotalPaisa, Converter={StaticResource MoneyConverter}}" Width="110"/>
                    <DataGridTextColumn Header="{DynamicResource Status}" Binding="{Binding Status}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0">
                <Button Content="{DynamicResource PrintQuotation}" Style="{StaticResource BigButton}"
                        Command="{Binding PrintQuotationCommand}"/>
                <Button Content="{DynamicResource EditQuotation}" Style="{StaticResource BigButton}"
                        Command="{Binding EditQuotationCommand}"
                        IsEnabled="{Binding CanEdit}"/>
                <Button Content="{DynamicResource ConvertToBill}" Style="{StaticResource PrimaryButton}"
                        Command="{Binding ConvertToBillCommand}"
                        IsEnabled="{Binding CanConvert}"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
