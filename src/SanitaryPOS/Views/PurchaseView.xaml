<UserControl x:Class="SanitaryPOS.Views.PurchaseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="215"/>
        </Grid.RowDefinitions>

        <!-- ===== Top: GRN entry ===== -->
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="58"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{DynamicResource PurchaseTitle}" Style="{StaticResource HeaderText}"/>

            <!-- Supplier + inline new supplier -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="170"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="{DynamicResource Supplier}" Style="{StaticResource FormLabel}"/>
                    <ComboBox ItemsSource="{Binding SupplierOptions}" SelectedItem="{Binding SelectedSupplier}"
                              Style="{StaticResource FormCombo}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                    <TextBlock Text="{DynamicResource NewSupplierName}" Style="{StaticResource FormLabel}"/>
                    <TextBox Text="{Binding NewSupplierName}" Style="{StaticResource FormTextBox}"/>
                </StackPanel>
                <Button Grid.Column="2" Content="{DynamicResource AddSupplier}" Style="{StaticResource BigButton}"
                        Command="{Binding AddSupplierCommand}" VerticalAlignment="Bottom" Margin="0,0,8,6"/>
                <StackPanel Grid.Column="3" Margin="0,0,8,0">
                    <TextBlock Text="{DynamicResource SupplierBillNo}" Style="{StaticResource FormLabel}"/>
                    <TextBox Text="{Binding SupplierBillNo}" Style="{StaticResource FormTextBox}"/>
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="{DynamicResource Date}" Style="{StaticResource FormLabel}"/>
                    <DatePicker SelectedDate="{Binding PurchaseDate}" FontSize="14" Margin="0,0,0,4"/>
                </StackPanel>
            </Grid>

            <TextBox x:Name="SearchBox" Grid.Row="2" FontSize="15" Padding="7,5" Margin="0,2,0,4"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="{DynamicResource ScanOrSearch}" KeyDown="SearchBox_KeyDown"/>

            <ListBox x:Name="ResultsList" Grid.Row="3" FontSize="12.5" ItemsSource="{Binding SearchResults}"
                     MouseDoubleClick="ResultsList_MouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock>
                            <Run Text="{Binding Name, Mode=OneWay}" FontWeight="Bold"/>
                            <Run Text="  |  "/><Run Text="{Binding BrandName, Mode=OneWay}"/>
                            <Run Text="  |  Stock: "/><Run Text="{Binding StockQty, Mode=OneWay}"/>
                            <Run Text="  |  "/><Run Text="{Binding PurchaseRatePaisa, Converter={StaticResource MoneyConverter}, Mode=OneWay}"/>
                        </TextBlock>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <DataGrid Grid.Row="4" ItemsSource="{Binding Lines}" AutoGenerateColumns="False"
                      CanUserAddRows="False" FontSize="13.5" Margin="0,4,0,0" RowHeight="29">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{DynamicResource Item}" Binding="{Binding ProductName}" Width="*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="{DynamicResource Qty}" Binding="{Binding Qty, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                    <DataGridTextColumn Header="{DynamicResource PurchaseRate}" Binding="{Binding RateRupees, UpdateSourceTrigger=PropertyChanged, StringFormat=0.##}" Width="120"/>
                    <DataGridTextColumn Header="{DynamicResource LineTotal}" Binding="{Binding LineTotalPaisa, Converter={StaticResource MoneyConverter}}" Width="120" IsReadOnly="True"/>
                    <DataGridTemplateColumn Width="86">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="{DynamicResource Remove}"
                                        Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock VerticalAlignment="Center">
                    <Run Text="{DynamicResource Subtotal}"/><Run Text=": "/>
                    <Run Text="{Binding SubtotalText, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock Text="{DynamicResource BillDiscount}" VerticalAlignment="Center" Margin="16,0,4,0"/>
                <TextBox Text="{Binding DiscountText, UpdateSourceTrigger=PropertyChanged}" Width="100" FontSize="14" Padding="5,3"/>
                <TextBlock FontSize="17" FontWeight="Bold" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Run Text="{DynamicResource GrandTotal}"/><Run Text=": "/>
                    <Run Text="{Binding GrandTotalText, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock Text="{DynamicResource PaidNow}" VerticalAlignment="Center" Margin="16,0,4,0"/>
                <TextBox Text="{Binding PaidText, UpdateSourceTrigger=PropertyChanged}" Width="110" FontSize="14" Padding="5,3"/>
                <ComboBox ItemsSource="{Binding PaymentMethods}" SelectedItem="{Binding PaidMethod}"
                          Width="130" FontSize="13" Margin="6,0,0,0"/>
                <TextBlock VerticalAlignment="Center" Margin="16,0,0,0">
                    <Run Text="{DynamicResource BalancePayable}"/><Run Text=": "/>
                    <Run Text="{Binding BalancePayableText, Mode=OneWay}" FontWeight="Bold"/>
                </TextBlock>
                <Button Content="{DynamicResource SavePurchase}" Style="{StaticResource PrimaryButton}"
                        Command="{Binding SavePurchaseCommand}" Margin="18,0,0,0" MinWidth="170"/>
            </StackPanel>
        </Grid>

        <!-- ===== Bottom: history + detail ===== -->
        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" Margin="0,0,8,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="{DynamicResource PurchaseHistory}" FontWeight="Bold" FontSize="14"/>
                <DataGrid Grid.Row="1" ItemsSource="{Binding History}" SelectedItem="{Binding SelectedPurchase}"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" FontSize="13">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{DynamicResource Date}" Binding="{Binding CreatedAt, Converter={StaticResource DateConverter}}" Width="92"/>
                        <DataGridTextColumn Header="{DynamicResource Supplier}" Binding="{Binding SupplierName}" Width="*"/>
                        <DataGridTextColumn Header="{DynamicResource SupplierBillNo}" Binding="{Binding SupplierBillNo}" Width="90"/>
                        <DataGridTextColumn Header="{DynamicResource Total}" Binding="{Binding TotalPaisa, Converter={StaticResource MoneyConverter}}" Width="105"/>
                        <DataGridTextColumn Header="{DynamicResource Paid}" Binding="{Binding PaidPaisa, Converter={StaticResource MoneyConverter}}" Width="95"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="{DynamicResource Details}" FontWeight="Bold" FontSize="14"/>
                <DataGrid Grid.Row="1" ItemsSource="{Binding DetailItems}"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" FontSize="13">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{DynamicResource Item}" Binding="{Binding ProductName}" Width="*"/>
                        <DataGridTextColumn Header="{DynamicResource Qty}" Binding="{Binding Qty}" Width="60"/>
                        <DataGridTextColumn Header="{DynamicResource PurchaseRate}" Binding="{Binding PurchaseRatePaisa, Converter={StaticResource MoneyConverter}}" Width="110"/>
                        <DataGridTextColumn Header="{DynamicResource LineTotal}" Binding="{Binding LineTotalPaisa, Converter={StaticResource MoneyConverter}}" Width="110"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
