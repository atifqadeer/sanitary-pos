<UserControl x:Class="SanitaryPOS.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Border Width="380" Padding="28" Background="White" BorderBrush="#DDD" BorderThickness="1"
                CornerRadius="10" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="{DynamicResource AppTitle}" FontSize="24" FontWeight="Bold"
                           TextAlignment="Center" Margin="0,0,0,4"/>
                <TextBlock Text="{DynamicResource Login}" FontSize="16" TextAlignment="Center" Margin="0,0,0,16"/>

                <TextBlock Text="{DynamicResource Username}" Style="{StaticResource FormLabel}"/>
                <TextBox x:Name="UsernameBox" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FormTextBox}"/>

                <TextBlock Text="{DynamicResource Password}" Style="{StaticResource FormLabel}"/>
                <!-- PasswordBox cannot bind directly; code-behind copies it into the ViewModel. -->
                <PasswordBox x:Name="PasswordBox" FontSize="14" Padding="6,4" Margin="0,0,0,10"
                             PasswordChanged="PasswordBox_PasswordChanged"/>

                <TextBlock Text="{Binding ErrorText}" Foreground="Red" TextWrapping="Wrap" Margin="0,0,0,8"/>

                <Button Content="{DynamicResource LoginButton}" Style="{StaticResource PrimaryButton}"
                        Command="{Binding LoginCommand}" IsDefault="True" Height="44" FontSize="17"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
