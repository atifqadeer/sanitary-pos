<UserControl x:Class="SanitaryPOS.Views.SuppliersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="430"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: total payable + search + supplier list -->
        <Grid Grid.Column="0" Margin="0,0,10,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="{DynamicResource SuppliersTitle}" Style="{StaticResource HeaderText}"/>
            <Border Grid.Row="1" Style="{StaticResource StatCard}" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{DynamicResource TotalPayable}" FontSize="14" Foreground="#555"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalPayableText}" FontSize="20" FontWeight="Bold" Margin="10,0,0,0"/>
                </StackPanel>
            </Border>
            <TextBox Grid.Row="2" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource FormTextBox}" FontSize="14"/>
            <DataGrid Grid.Row="3" ItemsSource="{Binding Suppliers}" SelectedItem="{Binding SelectedSupplier}"
                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" FontSize="13">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{DynamicResource Supplier}" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="{DynamicResource Mobile}" Binding="{Binding Mobile}" Width="105"/>
                    <DataGridTextColumn Header="{DynamicResource PayableWord}" Binding="{Binding BalancePaisa, Converter={StaticResource MoneyConverter}}" Width="105"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- Right: form + ledger + pay supplier -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Background="White" BorderBrush="#DDD" BorderThickness="1" Padding="12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="{DynamicResource AddSupplier}" Style="{StaticResource BigButton}"
                                    Command="{Binding NewSupplierCommand}"/>
                            <TextBlock FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="12,0,0,0">
                                <Run Text="{DynamicResource PayableWord}"/><Run Text=": "/>
                                <Run Text="{Binding BalanceText, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                <TextBlock Text="{DynamicResource Supplier}" Style="{StaticResource FormLabel}"/>
                                <TextBox Text="{Binding FormName}" Style="{StaticResource FormTextBox}"/>
                                <TextBlock Text="{DynamicResource ContactPerson}" Style="{StaticResource FormLabel}"/>
                                <TextBox Text="{Binding FormContactPerson}" Style="{StaticResource FormTextBox}"/>
                                <TextBlock Text="{DynamicResource Mobile}" Style="{StaticResource FormLabel}"/>
                                <TextBox Text="{Binding FormMobile}" Style="{StaticResource FormTextBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                <TextBlock Text="{DynamicResource Address}" Style="{StaticResource FormLabel}"/>
                                <TextBox Text="{Binding FormAddress}" Style="{StaticResource FormTextBox}"/>
                                <TextBlock Text="{DynamicResource City}" Style="{StaticResource FormLabel}"/>
                                <TextBox Text="{Binding FormCity}" Style="{StaticResource FormTextBox}"/>
                                <TextBlock Text="{DynamicResource OpeningBalancePayable}" Style="{StaticResource FormLabel}"/>
                                <TextBox Text="{Binding FormOpeningText}" Style="{StaticResource FormTextBox}"/>
                            </StackPanel>
                        </Grid>

                        <Button Content="{DynamicResource Save}" Style="{StaticResource PrimaryButton}"
                                Command="{Binding SaveSupplierCommand}" HorizontalAlignment="Left" MinWidth="140"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="{DynamicResource SupplierLedger}" FontSize="16" FontWeight="Bold" Margin="0,12,0,4"/>
                <DataGrid ItemsSource="{Binding Ledger}" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" FontSize="13" Height="220">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{DynamicResource Date}" Binding="{Binding DateText}" Width="95"/>
                        <DataGridTextColumn Header="{DynamicResource Description}" Binding="{Binding Description}" Width="*"/>
                        <DataGridTextColumn Header="{DynamicResource Debit}" Binding="{Binding DebitPaisa, Converter={StaticResource MoneyConverter}}" Width="100"/>
                        <DataGridTextColumn Header="{DynamicResource CreditCol}" Binding="{Binding CreditPaisa, Converter={StaticResource MoneyConverter}}" Width="100"/>
                        <DataGridTextColumn Header="{DynamicResource BalanceWord}" Binding="{Binding RunningBalancePaisa, Converter={StaticResource MoneyConverter}}" Width="105"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Border Background="White" BorderBrush="#DDD" BorderThickness="1" Padding="12" Margin="0,10,0,0">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Width="190" Margin="0,0,8,0">
                            <TextBlock Text="{DynamicResource PaymentAmount}" Style="{StaticResource FormLabel}"/>
                            <TextBox Text="{Binding PaymentAmountText}" Style="{StaticResource FormTextBox}" FontSize="15"/>
                        </StackPanel>
                        <StackPanel Width="150" Margin="0,0,8,0">
                            <TextBlock Text="{DynamicResource PaymentMethod}" Style="{StaticResource FormLabel}"/>
                            <ComboBox ItemsSource="{Binding PaymentMethods}" SelectedItem="{Binding PaymentMethod}" Style="{StaticResource FormCombo}"/>
                        </StackPanel>
                        <StackPanel Width="200" Margin="0,0,8,0">
                            <TextBlock Text="{DynamicResource Note}" Style="{StaticResource FormLabel}"/>
                            <TextBox Text="{Binding PaymentNote}" Style="{StaticResource FormTextBox}"/>
                        </StackPanel>
                        <Button Content="{DynamicResource PaySupplier}" Style="{StaticResource PrimaryButton}"
                                Command="{Binding PaySupplierCommand}" VerticalAlignment="Bottom"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
