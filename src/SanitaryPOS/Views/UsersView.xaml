<UserControl x:Class="SanitaryPOS.Views.UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="340"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                   Text="{DynamicResource UsersTitle}" Style="{StaticResource HeaderText}"/>

        <!-- ===== User list ===== -->
        <DataGrid Grid.Row="1" Grid.Column="0" ItemsSource="{Binding Users}"
                  SelectedItem="{Binding SelectedUser}" AutoGenerateColumns="False"
                  IsReadOnly="True" CanUserAddRows="False" Margin="0,0,10,0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{DynamicResource Username}" Binding="{Binding Username}" Width="*"/>
                <DataGridTextColumn Header="{DynamicResource FullName}" Binding="{Binding FullName}" Width="1.4*"/>
                <DataGridTextColumn Header="{DynamicResource RoleWord}" Binding="{Binding Role}" Width="90"/>
                <DataGridCheckBoxColumn Header="{DynamicResource ActiveWord}" Binding="{Binding IsActiveBool}" Width="70"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- ===== Right side: edit / new / my password ===== -->
        <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Button Content="{DynamicResource Refresh}" Style="{StaticResource BigButton}"
                        Command="{Binding RefreshUsersCommand}" HorizontalAlignment="Left" Margin="0,0,0,8"/>

                <Border BorderBrush="#CCC" BorderThickness="1" Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="{Binding SelectedUser.Username}" FontWeight="Bold" FontSize="15"/>
                        <TextBlock Text="{DynamicResource FullName}" Style="{StaticResource FormLabel}"/>
                        <TextBox Text="{Binding EditFullName}" Style="{StaticResource FormTextBox}"/>
                        <TextBlock Text="{DynamicResource RoleWord}" Style="{StaticResource FormLabel}"/>
                        <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding EditRole}"
                                  Style="{StaticResource FormCombo}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="{DynamicResource Save}" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding SaveUserEditCommand}"/>
                            <Button Content="{Binding ToggleActiveText}" Style="{StaticResource BigButton}"
                                    Command="{Binding ToggleActiveCommand}" Margin="8,0,0,0"/>
                        </StackPanel>

                        <TextBlock Text="{DynamicResource ResetPassword}" Style="{StaticResource FormLabel}"
                                   FontWeight="Bold" Margin="0,14,0,2"/>
                        <TextBlock Text="{DynamicResource NewPassword}" Style="{StaticResource FormLabel}"/>
                        <PasswordBox x:Name="ResetPasswordBox" FontSize="14" Padding="6,4" Margin="0,0,0,6"
                                     PasswordChanged="ResetPasswordBox_PasswordChanged"/>
                        <Button Content="{DynamicResource ResetPassword}" Style="{StaticResource BigButton}"
                                Command="{Binding ResetPasswordCmdCommand}" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

                <Border BorderBrush="#CCC" BorderThickness="1" Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource NewUser}" FontWeight="Bold" FontSize="15"/>
                        <TextBlock Text="{DynamicResource Username}" Style="{StaticResource FormLabel}"/>
                        <TextBox Text="{Binding NewUsername}" Style="{StaticResource FormTextBox}"/>
                        <TextBlock Text="{DynamicResource FullName}" Style="{StaticResource FormLabel}"/>
                        <TextBox Text="{Binding NewFullName}" Style="{StaticResource FormTextBox}"/>
                        <TextBlock Text="{DynamicResource NewPassword}" Style="{StaticResource FormLabel}"/>
                        <PasswordBox x:Name="NewPasswordBox" FontSize="14" Padding="6,4" Margin="0,0,0,6"
                                     PasswordChanged="NewPasswordBox_PasswordChanged"/>
                        <TextBlock Text="{DynamicResource RoleWord}" Style="{StaticResource FormLabel}"/>
                        <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding NewRole}"
                                  Style="{StaticResource FormCombo}"/>
                        <Button Content="{DynamicResource AddNew}" Style="{StaticResource PrimaryButton}"
                                Command="{Binding CreateUserCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <Border BorderBrush="#CCC" BorderThickness="1" Padding="10">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource ChangePassword}" FontWeight="Bold" FontSize="15"/>
                        <TextBlock Text="{DynamicResource CurrentPassword}" Style="{StaticResource FormLabel}"/>
                        <PasswordBox x:Name="MyCurrentBox" FontSize="14" Padding="6,4" Margin="0,0,0,6"
                                     PasswordChanged="MyCurrentBox_PasswordChanged"/>
                        <TextBlock Text="{DynamicResource NewPassword}" Style="{StaticResource FormLabel}"/>
                        <PasswordBox x:Name="MyNewBox" FontSize="14" Padding="6,4" Margin="0,0,0,6"
                                     PasswordChanged="MyNewBox_PasswordChanged"/>
                        <TextBlock Text="{DynamicResource ConfirmPassword}" Style="{StaticResource FormLabel}"/>
                        <PasswordBox x:Name="MyConfirmBox" FontSize="14" Padding="6,4" Margin="0,0,0,6"
                                     PasswordChanged="MyConfirmBox_PasswordChanged"/>
                        <Button Content="{DynamicResource ChangePassword}" Style="{StaticResource PrimaryButton}"
                                Command="{Binding ChangeMyPasswordCommand}" HorizontalAlignment="Left" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
