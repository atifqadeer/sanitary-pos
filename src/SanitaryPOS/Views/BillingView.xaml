<UserControl x:Class="SanitaryPOS.Views.BillingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- F2 = New Bill, F9 = Save + Print (work whenever focus is inside this screen) -->
    <UserControl.InputBindings>
        <KeyBinding Key="F2" Command="{Binding NewBillCommand}"/>
        <KeyBinding Key="F9" Command="{Binding SaveAndPrintCommand}"/>
    </UserControl.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: search + customer + price level + payment method -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="160"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="SearchBox" Grid.Column="0"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     FontSize="17" Padding="8,6" Margin="0,0,8,6"
                     ToolTip="{DynamicResource ScanOrSearch}"
                     KeyDown="SearchBox_KeyDown"/>

            <ComboBox Grid.Column="1" ItemsSource="{Binding CustomerOptions}"
                      SelectedItem="{Binding SelectedCustomer}"
                      FontSize="14" Padding="6,4" Margin="0,0,8,6"/>

            <ComboBox Grid.Column="2" ItemsSource="{Binding PriceLevels}"
                      SelectedItem="{Binding SelectedPriceLevel}"
                      FontSize="14" Padding="6,4" Margin="0,0,8,6"/>

            <ComboBox Grid.Column="3" ItemsSource="{Binding PaymentMethods}"
                      SelectedItem="{Binding SelectedPaymentMethod}"
                      FontSize="14" Padding="6,4" Margin="0,0,0,6"/>
        </Grid>

        <!-- Labels for the row above (kept tiny to save vertical space) -->
        <!-- Row 1: live search results (double-click to add) -->
        <ListBox x:Name="ResultsList" Grid.Row="1" Height="76" FontSize="13"
                 ItemsSource="{Binding SearchResults}"
                 MouseDoubleClick="ResultsList_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock>
                        <Run Text="{Binding Name, Mode=OneWay}" FontWeight="Bold"/>
                        <Run Text="  |  "/>
                        <Run Text="{Binding BrandName, Mode=OneWay}"/>
                        <Run Text="  |  Stock: "/>
                        <Run Text="{Binding StockQty, Mode=OneWay}"/>
                        <Run Text="  |  "/>
                        <Run Text="{Binding RetailRatePaisa, Converter={StaticResource MoneyConverter}, Mode=OneWay}"/>
                    </TextBlock>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Row 2: bill lines -->
        <DataGrid Grid.Row="2" ItemsSource="{Binding Lines}" AutoGenerateColumns="False"
                  CanUserAddRows="False" FontSize="14" Margin="0,6,0,0"
                  RowHeight="30" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{DynamicResource Item}" Binding="{Binding ProductName}" Width="*" IsReadOnly="True"/>
                <DataGridTextColumn Header="{DynamicResource Qty}" Binding="{Binding Qty, UpdateSourceTrigger=PropertyChanged}" Width="64"/>
                <DataGridTextColumn Header="{DynamicResource Rate}" Binding="{Binding RateRupees, UpdateSourceTrigger=PropertyChanged, StringFormat=0.##}" Width="96"/>
                <DataGridTemplateColumn Header="%" Width="86">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding DataContext.DiscountModes, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      SelectedItem="{Binding DiscountMode, UpdateSourceTrigger=PropertyChanged}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="{DynamicResource DiscountValue}" Binding="{Binding DiscountValue, UpdateSourceTrigger=PropertyChanged, StringFormat=0.##}" Width="86"/>
                <DataGridTextColumn Header="{DynamicResource DiscountRs}" Binding="{Binding DiscountPaisa, Converter={StaticResource MoneyConverter}}" Width="96" IsReadOnly="True"/>
                <DataGridTextColumn Header="{DynamicResource LineTotal}" Binding="{Binding LineTotalPaisa, Converter={StaticResource MoneyConverter}}" Width="110" IsReadOnly="True"/>
                <DataGridTemplateColumn Width="86">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="{DynamicResource Remove}"
                                    Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Row 3: held bills (only when toggled) -->
        <Border Grid.Row="3" Background="#FFF8E1" BorderBrush="#FFE082" BorderThickness="1" Padding="6" Margin="0,6,0,0"
                Visibility="{Binding HeldListVisible, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="{DynamicResource HeldBills}" FontWeight="Bold"/>
                <ItemsControl ItemsSource="{Binding HeldBills}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock VerticalAlignment="Center">
                                    <Run Text="#"/><Run Text="{Binding BillNo, Mode=OneWay}"/>
                                    <Run Text="  "/><Run Text="{Binding CustomerName, Mode=OneWay}"/>
                                    <Run Text="  "/><Run Text="{Binding TotalPaisa, Converter={StaticResource MoneyConverter}, Mode=OneWay}"/>
                                </TextBlock>
                                <Button Content="{DynamicResource RecallBill}" Margin="10,0,0,0" Padding="10,2"
                                        Command="{Binding DataContext.RecallBillCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Row 4: totals + payment + actions -->
        <Grid Grid.Row="4" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="{Binding StatusMessage}" Foreground="#1E7D32" FontWeight="Bold"
                           FontSize="13" TextWrapping="Wrap" Margin="0,0,8,4"
                           Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVis}}"/>
                <TextBlock>
                    <Run Text="{DynamicResource Subtotal}"/><Run Text=":  "/>
                    <Run Text="{Binding SubtotalText, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock>
                    <Run Text="{DynamicResource ItemDiscount}"/><Run Text=":  "/>
                    <Run Text="{Binding ItemDiscountText, Mode=OneWay}"/>
                </TextBlock>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{DynamicResource BillDiscount}" VerticalAlignment="Center" Width="170"/>
                    <TextBox Text="{Binding BillDiscountText, UpdateSourceTrigger=PropertyChanged}" Width="110" FontSize="14" Padding="5,3"/>
                </StackPanel>
                <TextBlock>
                    <Run Text="{DynamicResource Tax}"/><Run Text=":  "/>
                    <Run Text="{Binding TaxText, Mode=OneWay}"/>
                </TextBlock>
            </StackPanel>

            <StackPanel Grid.Column="1">
                <TextBlock FontSize="21" FontWeight="Bold">
                    <Run Text="{DynamicResource GrandTotal}"/><Run Text=":  "/>
                    <Run Text="{Binding GrandTotalText, Mode=OneWay}"/>
                </TextBlock>
                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                    <TextBlock Text="{DynamicResource PaidAmount}" VerticalAlignment="Center" Width="170"/>
                    <TextBox Text="{Binding PaidText, UpdateSourceTrigger=PropertyChanged}" Width="130" FontSize="16" Padding="5,3"/>
                </StackPanel>
                <TextBlock>
                    <Run Text="{DynamicResource Change}"/><Run Text=":  "/>
                    <Run Text="{Binding ChangeText, Mode=OneWay}"/>
                    <Run Text="    "/>
                    <Run Text="{DynamicResource BalanceToKhata}"/><Run Text=":  "/>
                    <Run Text="{Binding BalanceToKhataText, Mode=OneWay}" FontWeight="Bold"/>
                </TextBlock>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Content="{DynamicResource NewBill}" Style="{StaticResource BigButton}"
                        Command="{Binding NewBillCommand}"/>
                <Button Content="{DynamicResource HoldBill}" Style="{StaticResource BigButton}"
                        Command="{Binding HoldBillCommand}"/>
                <Button Content="{DynamicResource HeldBills}" Style="{StaticResource BigButton}"
                        Command="{Binding ToggleHeldListCommand}"/>
                <Button Content="{DynamicResource ReprintLastBill}" Style="{StaticResource BigButton}"
                        Command="{Binding ReprintLastBillCommand}"/>
                <Button Content="{DynamicResource SaveBill}" Style="{StaticResource BigButton}"
                        Command="{Binding SaveBillCommand}"/>
                <Button Content="{DynamicResource SaveAndPrint}" Style="{StaticResource PrimaryButton}"
                        Command="{Binding SaveAndPrintCommand}" MinWidth="160" Height="46" FontSize="16"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
